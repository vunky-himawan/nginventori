generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  id             BigInt          @id @default(autoincrement())
  clerkId        String          @unique @map("clerk_id") @db.VarChar(255)
  profilePicture String?         @db.VarChar(255) @map("profile_picture")
  roleId         BigInt          @map("role_id") @db.BigInt
  locationId     BigInt          @map("location_id") @db.BigInt
  departmentId   BigInt          @map("department_id") @db.BigInt
  positionId     BigInt          @map("position_id") @db.BigInt
  typeId         BigInt          @map("type_id") @db.BigInt
  headId         BigInt?         @map("head_id") @db.BigInt
  levelId        BigInt?         @map("level_id") @db.BigInt
  email          String          @unique @db.VarChar(255)
  password       String?         @db.VarChar(255)
  name           String          @db.VarChar(255)
  birthLocation  String          @map("birth_location") @db.VarChar(255)
  birthDate      DateTime        @map("birth_date")
  gender         Gender
  waNumber       String          @map("wa_number") @db.VarChar(255)
  nik            String          @unique @db.VarChar(20)
  livingAddress  String?         @map("living_address") @db.VarChar(255)
  religion       Religion?
  marriageStatus MarriageStatus? @map("mirrage_status")
  bloodType      BloodType?      @map("blood_type")
  city           String?         @db.VarChar(255)
  province       String?         @db.VarChar(255)
  postalCode     String?         @map("postal_code") @db.VarChar(255)
  joinedDate     DateTime        @map("joined_date")
  assessmentDate DateTime?       @map("assessment_date")
  resignedDate   DateTime?       @map("resigned_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  role       Role             @relation(fields: [roleId], references: [id])
  location   OfficeLocation   @relation(fields: [locationId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])
  position   EmployeePosition @relation(fields: [positionId], references: [id])
  type       EmployeeType     @relation(fields: [typeId], references: [id])
  level      Level?           @relation(fields: [levelId], references: [id])
  head       User?            @relation("Head", fields: [headId], references: [id])

  subordinates            User[]                       @relation("Head")
  activityLogs            ActivityLog[]
  responsibility          InventoryResponsibility[]
  maintenanceDetails      InventoryMaintenanceDetail[]
  submissions             AuditSubmission[]
  inventoryAudits         InventoryAudit[]
  inventoryReports        InventoryReport[]
  submittedMonthlyReports InventoryMonthlyReport[]     @relation("SubmittedBy")
  auditedMonthlyReports   InventoryMonthlyReport[]     @relation("AuditedBy")

  @@map("users")
}

model ActivityLog {
  id          BigInt   @id @default(autoincrement())
  actorId     BigInt   @map("actor_id") @db.BigInt
  logName     String   @map("log_name") @db.VarChar(255)
  description String   @db.VarChar(255)
  subjectType String   @map("subject_type") @db.VarChar(255)
  action      Action
  properties  Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}

model Role {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users       User[]
  permissions RoleHasPermission[]

  @@index([name, deletedAt])
  @@map("roles")
}

model Permission {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(255)

  roles RoleHasPermission[]

  @@map("permissions")
}

model RoleHasPermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

model EmployeePosition {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]

  @@index([name, deletedAt])
  @@map("employee_positions")
}

model EmployeeType {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]

  @@index([name, deletedAt])
  @@map("employee_types")
}

model Department {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users              User[]
  inventoryLocations InventoryLocation[]

  @@index([name, deletedAt])
  @@map("departments")
}

model Level {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  minPeriod Int       @map("min_period")
  maxPeriod Int       @map("max_period")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]

  @@index([name, deletedAt])
  @@map("levels")
}

model OfficeLocation {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users              User[]
  inventoryLocations InventoryLocation[]

  @@index([name, deletedAt])
  @@map("office_locations")
}

model InventoryItem {
  id                BigInt    @id @default(autoincrement())
  locationId        BigInt    @map("location_id") @db.BigInt
  name              String    @db.VarChar(255)
  description       String?   @db.Text
  price             Decimal   @db.Decimal(10, 2)
  totalQuantity     Int       @map("total_quantity")
  availableQuantity Int       @map("available_quantity")
  loanedQuantity    Int       @map("loaned_quantity")
  damagedQuantity   Int       @map("damaged_quantity")
  lostQuantity      Int       @map("lost_quantity")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  location InventoryLocation @relation(fields: [locationId], references: [id])

  categories         InventoryItemHasInventoryCategory[]
  inventoryItemUnits InventoryItemUnit[]
  responsibilities   InventoryResponsibility[]

  @@unique([locationId, name])
  @@map("inventory_items")
}

model InventoryCategory {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  inventoryItems InventoryItemHasInventoryCategory[]

  @@index([name, deletedAt])
  @@map("inventory_categories")
}

model InventoryItemHasInventoryCategory {
  inventoryItemId     BigInt @map("inventory_item_id")
  inventoryCategoryId BigInt @map("inventory_category_id")

  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  inventoryCategory InventoryCategory @relation(fields: [inventoryCategoryId], references: [id])

  @@id([inventoryItemId, inventoryCategoryId])
  @@map("inventory_items_has_inventory_categories")
}

model InventoryResponsibility {
  inventoryItemId   BigInt @map("inventory_item_id")
  responsibleUserId BigInt @map("responsible_user_id")

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  responsibleUser User          @relation(fields: [responsibleUserId], references: [id])

  @@id([inventoryItemId, responsibleUserId])
  @@map("inventory_responsibilities")
}

model InventoryMaintenance {
  id        BigInt            @id @default(autoincrement())
  startDate DateTime          @map("start_date")
  endDate   DateTime          @map("end_date")
  note      String?           @db.Text
  status    MaintenanceStatus
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")

  inventoryMaintenanceDetails InventoryMaintenanceDetail[]

  @@map("inventory_maintenances")
}

model InventoryItemUnit {
  id              BigInt                  @id @default(autoincrement())
  inventoryItemId BigInt                  @map("inventory_item_id") @db.BigInt
  serialNumber    String                  @unique @map("serial_number")
  status          InventoryItemUnitStatus
  barcode         String?                 @db.VarChar(255)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  inventoryMaintenanceDetails InventoryMaintenanceDetail[]
  loanDetails                 InventoryLoanDetail[]

  @@map("inventory_item_units")
}

model InventoryMaintenanceDetail {
  inventoryMaintenanceId BigInt @map("inventory_maintenance_id")
  inventoryItemUnitId    BigInt @map("inventory_item_unit_id")
  maintenancePersonId    BigInt @map("maintenance_person_id")

  inventoryMaintenance InventoryMaintenance @relation(fields: [inventoryMaintenanceId], references: [id])
  inventoryItemUnit    InventoryItemUnit    @relation(fields: [inventoryItemUnitId], references: [id])
  maintenancePerson    User                 @relation(fields: [maintenancePersonId], references: [id])

  @@id([inventoryMaintenanceId, inventoryItemUnitId, maintenancePersonId])
  @@map("inventory_maintenance_details")
}

model InventoryLocation {
  id               BigInt    @id @default(autoincrement())
  officeLocationId BigInt    @map("office_location_id") @db.BigInt
  departmentId     BigInt    @map("department_id") @db.BigInt
  name             String    @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  location   OfficeLocation @relation(fields: [officeLocationId], references: [id])
  department Department     @relation(fields: [departmentId], references: [id])

  inventoryItems InventoryItem[]
  monthlyReports InventoryMonthlyReport[]

  @@index([name, deletedAt])
  @@map("inventory_locations")
}

model InventoryLoan {
  id           BigInt     @id @default(autoincrement())
  loanPersonId BigInt     @map("loan_person_id") @db.BigInt
  loanDate     DateTime   @map("loan_date")
  returnDate   DateTime   @map("return_date")
  note         String?    @db.Text
  status       LoanStatus
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  loanDetails InventoryLoanDetail[]

  @@map("inventory_loans")
}

model InventoryLoanDetail {
  inventoryLoanId     BigInt @map("inventory_loan_id")
  inventoryItemUnitId BigInt @map("inventory_item_unit_id")

  inventoryLoan     InventoryLoan     @relation(fields: [inventoryLoanId], references: [id])
  inventoryItemUnit InventoryItemUnit @relation(fields: [inventoryItemUnitId], references: [id])

  @@id([inventoryLoanId, inventoryItemUnitId])
  @@map("inventory_loan_details")
}

model InventoryReport {
  id                  BigInt     @id @default(autoincrement())
  inventoryItemUnitId BigInt     @map("inventory_item_unit_id") @db.BigInt
  reportedBy          BigInt     @map("reported_by") @db.BigInt
  reportType          ReportType @map("report_type")
  report              String?    @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  reporter User @relation(fields: [reportedBy], references: [id])

  @@map("inventory_reports")
}

model InventoryMonthlyReport {
  id                   BigInt              @id @default(autoincrement())
  submittedBy          BigInt              @map("submitted_by") @db.BigInt
  auditedBy            BigInt              @map("audited_by") @db.BigInt
  inventoryLocationsId BigInt              @map("inventory_locations_id") @db.BigInt
  reportDate           DateTime            @map("report_date")
  totalItems           Int                 @map("total_items")
  availableItems       Int                 @map("available_items")
  loanedItems          Int                 @map("loaned_items")
  damagedItems         Int                 @map("damaged_items")
  maintainedItems      Int                 @map("maintained_items")
  lostItems            Int                 @map("lost_items")
  status               MonthlyReportStatus
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")

  inventoryMonthlyReportSubmittedBy User              @relation("SubmittedBy", fields: [submittedBy], references: [id])
  inventoryMonthlyReportAuditedBy   User              @relation("AuditedBy", fields: [auditedBy], references: [id])
  inventoryLocations                InventoryLocation @relation(fields: [inventoryLocationsId], references: [id])

  inventoryAudits InventoryAudit[]

  @@map("inventory_monthly_reports")
}

model InventoryAudit {
  id              BigInt      @id @default(autoincrement())
  monthlyReportId BigInt      @map("monthly_report_id") @db.BigInt
  auditedBy       BigInt      @map("audited_by") @db.BigInt
  auditDate       DateTime    @map("audit_date")
  findings        String?     @db.Text
  status          AuditStatus
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  monthlyReport      InventoryMonthlyReport @relation(fields: [monthlyReportId], references: [id])
  inventoryAuditedBy User                   @relation(fields: [auditedBy], references: [id])

  submissions AuditSubmission[]

  @@map("inventory_audits")
}

model AuditSubmission {
  id               BigInt   @id @default(autoincrement())
  inventoryAuditId BigInt   @map("inventory_audit_id") @db.BigInt
  submittedTo      BigInt   @map("submitted_to") @db.BigInt
  submissionDate   DateTime @map("submissions_date")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  inventoryAudit   InventoryAudit @relation(fields: [inventoryAuditId], references: [id])
  auditSubmittedTo User           @relation(fields: [submittedTo], references: [id])

  @@map("audit_submissions")
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  CHRISTIAN
  HINDU
  BUDDHIST
  OTHER
}

enum MarriageStatus {
  MARRIED
  SINGLE
  WIDOW
  WIDOWER
}

enum BloodType {
  A
  B
  AB
  O
  OTHER
}

enum Action {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum LoanStatus {
  REQUEST
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryItemUnitStatus {
  AVAILABLE
  LOANED
  DAMAGED
  LOST
}

enum ReportType {
  DAMAGE
  LOSS
  OTHER
}

enum MonthlyReportStatus {
  PENDING
  AUDITED
}

enum AuditStatus {
  APPROVED
  REJECTED
  REVIEW_REQUIRED
}
